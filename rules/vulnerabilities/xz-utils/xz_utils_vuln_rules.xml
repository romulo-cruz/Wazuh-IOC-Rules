<group name="vulnerability,xz_utils">
  <!-- Detecção da CVE-2024-3094 -->
  <rule id="100401" level="15">
    <if_sid>23505</if_sid>
    <field name="vulnerability.cve">^CVE-2024-3094$</field>
    <description>Vulnerabilidade crítica do XZ Utils (CVE-2024-3094) detectada</description>
    <mitre>
      <id>T1195.001</id>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- Detecção de versões vulneráveis -->
  <rule id="100402" level="14">
    <if_sid>23505</if_sid>
    <field name="vulnerability.package.name">^xz-utils$</field>
    <field name="vulnerability.package.version">^5\.6\.[01]$</field>
    <description>Versão vulnerável do XZ Utils detectada ($(vulnerability.package.version))</description>
    <mitre>
      <id>T1195.001</id>
    </mitre>
  </rule>

  <!-- Correlação com atividade SSH -->
  <rule id="100403" level="15">
    <if_sid>100401</if_sid>
    <if_matched_sid>5715</if_matched_sid>
    <same_source_ip />
    <description>Possível exploração da CVE-2024-3094 via SSH detectada</description>
    <mitre>
      <id>T1190</id>
      <id>T1021.004</id>
    </mitre>
  </rule>
</group> 