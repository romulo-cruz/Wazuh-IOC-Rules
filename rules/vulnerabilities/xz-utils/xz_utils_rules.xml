<group name="linux,sshd,xz_utils,vulnerability">
  <!-- Monitoramento de processos filhos do SSHD suspeitos -->
  <rule id="100010" level="12" ignore="60">
    <if_sid>530</if_sid>
    <match>^ossec: output: 'sshd_child_processes'</match>
    <regex type="pcre2">\S+\s+\d+\s+\d+\s+\d+\s+\S+\s+\S+\s+\S+\s+(?!sshd:|unix_chkpwd)</regex>
    <description>SSHD iniciou um processo filho suspeito. Possível exploração da vulnerabilidade CVE-2024-3094.</description>
    <mitre>
      <id>T1210</id>
      <id>T1190</id>
      <id>T1195</id>
    </mitre>
  </rule>

  <!-- Detecção de portas suspeitas -->
  <rule id="100011" level="12">
    <if_sid>533</if_sid>
    <match>^ossec: output: 'netstat_listening'</match>
    <regex type="pcre2">(?:LISTEN|listening)</regex>
    <description>Nova porta de escuta detectada. Possível shell reverso da exploração CVE-2024-3094.</description>
    <mitre>
      <id>T1571</id>
    </mitre>
  </rule>

  <!-- Correlação de eventos -->
  <rule id="100012" level="14">
    <if_sid>100010</if_sid>
    <if_matched_sid>100011</if_matched_sid>
    <same_source_ip />
    <description>Alta probabilidade de exploração da CVE-2024-3094: Processo SSHD suspeito e nova porta detectados.</description>
    <mitre>
      <id>T1190</id>
      <id>T1571</id>
    </mitre>
  </rule>
</group> 