<group name="vulnerabilities,text4shell,apache">
  <!-- Detecção de tentativas de exploração do Text4Shell -->
  <rule id="100002" level="12">
    <if_sid>31100</if_sid>
    <url type="pcre2">%24%7B(script%3A(javascript|JEXL)%3A|url%3AUTF-8%3A|dns%3A(address|canonical-name|name)%7C)</url>
    <description>Possível tentativa de exploração do Text4Shell (CVE-2022-42889) detectada de $(srcip)</description>
    <mitre>
      <id>T1190</id>
      <id>T1203</id>
      <id>T1210</id>
    </mitre>
  </rule>

  <!-- Correlação com logs do Java -->
  <rule id="100003" level="12">
    <if_sid>1002</if_sid>
    <match>StringSubstitutor</match>
    <regex>script:|dns:|url:</regex>
    <description>Possível execução de código via Text4Shell detectada</description>
    <mitre>
      <id>T1059.007</id>
    </mitre>
  </rule>
</group> 