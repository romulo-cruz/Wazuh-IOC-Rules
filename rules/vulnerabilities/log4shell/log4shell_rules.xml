<group name="log4j,attack,">
  <!-- Detecção de padrões de exploração -->
  <rule id="100800" level="7">
    <if_group>web|accesslog|attack</if_group>
    <regex type="pcre2">(?i)(((\$|24)\S*)((\{|7B)\S*)((\S*j\S*n\S*d\S*i))|JHtqbmRp)</regex>
    <description>Possível tentativa de ataque Log4j RCE detectada.</description>
    <mitre>
      <id>T1190</id>
      <id>T1210</id>
      <id>T1211</id>
    </mitre>
  </rule>

  <!-- Detecção de protocolos maliciosos -->
  <rule id="100801" level="12">
    <if_sid>100800</if_sid>
    <regex type="pcre2">ldap[s]?|rmi|dns|nis|iiop|corba|nds|http|lower|upper|(\$\{\S*\w\}\S*)+</regex>
    <description>Tentativa de ataque Log4j RCE detectada.</description>
    <mitre>
      <id>T1190</id>
      <id>T1210</id>
      <id>T1211</id>
    </mitre>
  </rule>

  <!-- Correlação com eventos Java -->
  <rule id="100802" level="14">
    <if_sid>100801</if_sid>
    <if_group>java</if_group>
    <description>Ataque Log4j RCE detectado com execução Java correlacionada.</description>
    <mitre>
      <id>T1190</id>
      <id>T1210</id>
      <id>T1211</id>
    </mitre>
  </rule>
</group> 