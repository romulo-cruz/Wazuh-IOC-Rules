<group name="linux,lotl,attack">
  <!-- Detecção de comandos suspeitos via curl -->
  <rule id="100301" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">curl.*\|.*bash</field>
    <description>Possível ataque LOTL: Execução de comando via curl e pipe</description>
    <mitre>
      <id>T1059.004</id>
    </mitre>
  </rule>

  <!-- Detecção de DDexec -->
  <rule id="100302" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">ddexec\.sh</field>
    <description>Possível ataque LOTL: Uso do DDexec detectado</description>
    <mitre>
      <id>T1059.004</id>
      <id>T1055</id>
    </mitre>
  </rule>

  <!-- Modificação do /etc/passwd -->
  <rule id="100303" level="15">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">/etc/passwd</field>
    <description>Alerta crítico: Modificação do arquivo /etc/passwd detectada</description>
    <mitre>
      <id>T1548.001</id>
    </mitre>
  </rule>

  <!-- Correlação de eventos -->
  <rule id="100304" level="15">
    <if_sid>100301,100302</if_sid>
    <if_matched_sid>100303</if_matched_sid>
    <same_source_ip />
    <description>Ataque LOTL confirmado: Execução de comando suspeito e modificação do passwd</description>
    <mitre>
      <id>T1548</id>
    </mitre>
  </rule>
</group> 