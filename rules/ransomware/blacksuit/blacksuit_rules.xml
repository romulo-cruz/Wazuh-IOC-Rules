<group name="BlackSuit,ransomware">
  <!-- Execução do ransomware -->
  <rule id="100011" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.CommandLine" type="pcre2">(?i).*.exe\s+-name\s\d{32}$</field>
    <description>Possível execução do ransomware BlackSuit detectada</description>
    <mitre>
      <id>T1059</id>
      <id>T1086</id>
    </mitre>
  </rule>
  
  <!-- Remoção de shadow copies -->
  <rule id="100012" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.CommandLine" type="pcre2">(?i)vssadmin.exe\\"\sDelete\sShadows\s\/All\s\/Quiet</field>
    <description>Shadow copies deletadas usando $(win.eventdata.originalFileName). Possível atividade de ransomware detectada</description>
    <mitre>
      <id>T1490</id>
      <id>T1059.003</id>
    </mitre>
  </rule>
 
  <!-- Criação de nota de resgate -->
  <rule id="100013" level="15" timeframe="100" frequency="2">
    <if_sid>61613</if_sid>
    <field name="win.eventdata.image" type="pcre2">\.exe</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)[C-Z]:.*.\\README.BlackSuit.txt</field>
    <description>O arquivo $(win.eventdata.targetFilename) foi criado em múltiplos diretórios. Ransomware BlackSuit detectado</description>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>
</group> 