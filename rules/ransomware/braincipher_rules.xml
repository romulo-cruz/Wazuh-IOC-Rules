<group name="Brain Cipher, ransomware,">
  <!-- Detecção do executável do Brain Cipher -->
  <rule id="100121" level="12">
    <if_sid>61609</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)[C-Z]:.*\.exe</field>
    <field name="win.eventdata.hashes" type="pcre2">(?i)SHA256=EB82946FA0DE261E92F8F60AA878C9FEF9EBB34FDABABA66995403B110118B12</field>
    <description>Executável do ransomware Brain Cipher detectado.</description>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>

  <!-- Detecção de bypass UAC -->
  <rule id="100122" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i).*\\DllHost\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">.*3E5FC7F9-9A51-4367-9063-A120244FBEC7.*</field>
    <description>Tentativa de bypass UAC detectada - possível atividade do Brain Cipher.</description>
    <mitre>
      <id>T1548.002</id>
    </mitre>
  </rule>

  <!-- Detecção de acesso ao LSASS -->
  <rule id="100123" level="14">
    <if_sid>61610</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i).*\\lsass\.exe</field>
    <description>Tentativa de acesso ao LSASS detectada - possível roubo de credenciais.</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
  </rule>

  <!-- Detecção de modificação do registro VSS -->
  <rule id="100124" level="14">
    <if_sid>61615</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i).*\\System\\CurrentControlSet\\Services\\VSS.*</field>
    <description>Modificação do serviço VSS detectada - possível tentativa de prevenir recuperação.</description>
    <mitre>
      <id>T1490</id>
    </mitre>
  </rule>

  <!-- Detecção de nota de resgate -->
  <rule id="100125" level="15">
    <if_sid>61613</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i).*\.sYMY1N6ah\.README\.txt</field>
    <description>Nota de resgate do Brain Cipher detectada.</description>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>

  <!-- Detecção de arquivos criptografados -->
  <rule id="100126" level="15">
    <if_sid>550,554</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i).*\.sYMY1N6ah$</field>
    <description>Arquivo criptografado pelo Brain Cipher detectado.</description>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>
</group> 